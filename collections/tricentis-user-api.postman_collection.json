        {
          "id": "1848805c-89cb-4a72-8e30-03562769b054",
          "name": "Queries Users by Project Name",
          "request": {
            "name": "Queries Users by Project Name",
            "description": {
              "content": "To query for users by names of their assigned projects\n\n- Admin users with <em>Manage Client Users</em> permission can query users in any projects\n\n- For other users: the API only returns users within projects to which the requesting user is assigned",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v3",
                "search",
                "user"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "description": {
                    "content": "Name of the project whose users you want to query for. The API will return users which have been added to projects whose names contain the text specified in this parameter\n\n<strong>IMPORTANT:</strong> Project name is case sensitive",
                    "type": "text/plain"
                  },
                  "key": "projectName",
                  "value": ""
                },
                {
                  "description": {
                    "content": "<em>inactive=false</em> - default value. Inactive users are excluded from the response\n\n<em>inactive=true</em> - include inactive users",
                    "type": "text/plain"
                  },
                  "key": "inactive",
                  "value": ""
                },
                {
                  "description": {
                    "content": "<em>pagination=true</em> - default value. The result is paginated\n\n<em>pagination=false</em> - the result is not paginated",
                    "type": "text/plain"
                  },
                  "key": "pagination",
                  "value": ""
                },
                {
                  "description": {
                    "content": "By default the first page is returned but you can specify any page number to retrieve objects",
                    "type": "text/plain"
                  },
                  "key": "page",
                  "value": ""
                },
                {
                  "description": {
                    "content": "The result is paginated. By the default, the number of objects in each page is 100 if this is omitted. You can specify your custom number (up to 999) in this parameter",
                    "type": "text/plain"
                  },
                  "key": "pageSize",
                  "value": ""
                }
              ],
              "variable": []
            },
            "method": "GET"
          },
          "response": [
            {
              "id": "446c4d19-8ef7-4974-ab56-78630e3978ca",
              "name": "successful operation",
