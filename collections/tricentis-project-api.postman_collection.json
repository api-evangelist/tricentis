          "name": "Gets multiple Projects",
          "request": {
            "name": "Gets multiple Projects",
            "description": {
              "content": "To retrieve all Projects which the requested qTest  Manager account can access to\n\n<strong>qTest Manager version:</strong> 4+",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v3",
                "projects"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "description": {
                    "content": "<em>expand=userprofile</em> - to include your profile and permissions in each project (This can only be one of userprofile)",
                    "type": "text/plain"
                  },
                  "key": "expand",
                  "value": ""
                },
                {
                  "description": {
                    "content": "<em>assigned=true</em> - default value. Only the projects which the requested user has access to\n\n<em>assigned=false</em> - Users with admin profile can use this value to retrieve all projects, regardless of having access",
                    "type": "text/plain"
                  },
                  "key": "assigned",
                  "value": ""
                },
                {
                  "description": {
                    "content": "By default, all projects are returned; but you can specify any page number to retrieve objects",
                    "type": "text/plain"
                  },
                  "key": "page",
                  "value": ""
                },
                {
                  "description": {
                    "content": "The result is paginated. By the default, the number of objects in each page is 100 if this is omitted. You can specify your custom number (up to 999) in this parameter",
                    "type": "text/plain"
                  },
                  "key": "pageSize",
                  "value": ""
                }
              ],
              "variable": []
            },
            "method": "GET"
          },
