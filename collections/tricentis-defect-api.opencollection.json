  },
  "items": [
    {
      "info": {
        "name": "defect",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Submit a Defect",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://apitryout.qtestnet.com/api/v3/projects/:projectId/defects",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "ID of the project"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "To submit an internal Defect"
        },
        {
          "info": {
            "name": "Gets recently updated Defects",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://apitryout.qtestnet.com/api/v3/projects/:projectId/defects/last-change",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "ID of the project"
              },
              {
                "name": "startTime",
                "value": "",
                "type": "query",
                "description": "The specified time since when the Defects have been updated. It needs to be URL encoded: <em>yyyy-MM-dd'T'HH:mm:ss.SSSZ</em> or <em>yyyy-MM-dd'T'HH:mm:ssZZ</em>"
              },
              {
                "name": "endTime",
                "value": "",
                "type": "query",
                "description": "Do not support at this time. Use the current time only."
              },
              {
                "name": "size",
                "value": "",
                "type": "query",
                "description": "The result is paginated. By the default, the number of objects in each page is 100. You can specify your custom number in this parameter. The maximum page size is 999."
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "By default the first page is returned but you can specify any page number to retrieve objects"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "To retrieve Defects which have been recently updated after a specified time"
        },
        {
          "info": {
            "name": "Gets a Defect",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://apitryout.qtestnet.com/api/v3/projects/:projectId/defects/:defectId",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "ID of the project"
              },
              {
                "name": "defectId",
                "value": "",
                "type": "path",
                "description": "ID of the defect."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "To retrieve a Defect\n\n<strong>qTest Manager version:</strong> 6+"
        },
