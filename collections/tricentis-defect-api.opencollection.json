          "http": {
            "method": "PUT",
            "url": "https://apitryout.qtestnet.com/api/v3/projects/:projectId/defects/:defectId",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "ID of the project"
              },
              {
                "name": "defectId",
                "value": "",
                "type": "path",
                "description": "ID of the Defect which needs to be updated."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "To update a Defect\n\n<strong>qTest Manager version:</strong> 6+"
        },
