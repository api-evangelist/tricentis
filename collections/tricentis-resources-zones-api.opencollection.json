{
  "opencollection": "1.0.0",
  "info": {
    "name": "NeoLoad Resources|Zones API",
    "version": "3.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "accountToken",
      "value": "{{accountToken}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Resources|Zones",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all zones",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v3/resources/zones"
          },
          "docs": "Lists the zones."
        }
      ]
    }
  ],
  "bundled": true
}