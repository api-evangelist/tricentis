      "items": [
        {
          "info": {
            "name": "Gets multiple Releases",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://apitryout.qtestnet.com/api/v3/projects/:projectId/releases",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "ID of the project"
              },
              {
                "name": "includeClosed",
                "value": "",
                "type": "query",
                "description": "<em>includeClosed=false</em> - default value. <em>Closed</em> Releases are excluded from the response\n\n<em>includeClosed=true</em> - Closed Release are included in the response"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "To retrieve Releases in a project\n\n<strong>qTest Manager version:</strong> 4+"
        },
        {
