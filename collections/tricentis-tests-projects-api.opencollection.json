{
  "opencollection": "1.0.0",
  "info": {
    "name": "NeoLoad Tests|Projects API",
    "version": "3.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "accountToken",
      "value": "{{accountToken}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tests|Projects",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get project's metadata",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v3/workspaces/:workspaceId/tests/:testId/project",
            "params": [
              {
                "name": "workspaceId",
                "value": "",
                "type": "path",
                "description": "Unique identifier representing a Workspace."
              },
              {
                "name": "testId",
                "value": "",
                "type": "path",
                "description": "Unique identifier representing a specific test."
              }
            ]
          },
          "docs": "Get project's metadata"
        },
        {
          "info": {
            "name": "Uploads a NeoLoad project zip file or a standalone as-code file",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/v3/workspaces/:workspaceId/tests/:testId/project",
            "params": [
              {
                "name": "workspaceId",
                "value": "",
                "type": "path",
                "description": "Unique identifier representing a Workspace."
              },
              {
                "name": "testId",
                "value": "",
                "type": "path",
                "description": "Unique identifier representing a specific test."
              }
            ],
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "file",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Uploads a NeoLoad project of the Workspace corresponding to the parameters. The maximum size file is 250 MB"
        }
      ]
    }
  ],
  "bundled": true
}