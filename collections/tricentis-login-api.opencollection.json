{
  "opencollection": "1.0.0",
  "info": {
    "name": "qTest Manager API Version 3.0 Login API",
    "version": "v3.0"
  },
  "items": [
    {
      "info": {
        "name": "login",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Gets status of access token",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://apitryout.qtestnet.com/oauth/status",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Gets status of access token"
        },
        {
          "info": {
            "name": "Log in",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://apitryout.qtestnet.com/oauth/token",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "grant_type",
                  "value": ""
                },
                {
                  "name": "username",
                  "value": ""
                },
                {
                  "name": "password",
                  "value": ""
                },
                {
                  "name": "refresh_token",
                  "value": ""
                }
              ]
            }
          },
          "docs": "To authenticate the API client against qTest Manager and acquire authorized access token. \n\n Note: Please choose parameter <em>content-type=application/x-www-form-urlencoded</em>"
        }
      ]
    }
  ],
  "bundled": true
}