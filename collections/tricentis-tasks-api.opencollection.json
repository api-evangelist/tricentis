{
  "opencollection": "1.0.0",
  "info": {
    "name": "qTest Parameters Tasks API",
    "version": "2025.2"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-access-token",
      "value": "{{x-access-token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tasks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "GET /api/v1/tasks/{id}",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://parameter-1.qtestnet.com/api/v1/tasks/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "task id"
              }
            ]
          },
          "docs": "Get a task by id"
        },
        {
          "info": {
            "name": "GET /api/v1/tasks/{id}/result",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://parameter-1.qtestnet.com/api/v1/tasks/:id/result",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "id of the task to get result"
              }
            ]
          },
          "docs": "Get task result"
        }
      ]
    }
  ],
  "bundled": true
}