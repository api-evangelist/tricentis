              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "By default the first page is returned but you can specify any page number to retrieve requirements."
              },
              {
                "name": "size",
                "value": "",
                "type": "query",
                "description": "The result is paginated. By default, the number of requirements in each page is 20.\n\nYou can specify your custom number in this parameter and the maximum number is 999."
              },
              {
                "name": "fieldIds",
                "value": "",
                "type": "query",
                "description": "ID(s) of requirement fields (system or custom fields) which you would like to retrieve.\n\nThey are separated by commas."
              },
              {
                "name": "lastModifiedFrom",
                "value": "",
                "type": "query"
              },
              {
                "name": "lastModifiedTo",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "To retrieve a report of Requirements with their covering Test Cases"
        },
