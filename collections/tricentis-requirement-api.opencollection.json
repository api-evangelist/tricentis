  },
  "items": [
    {
      "info": {
        "name": "requirement",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Gets multiple Requirements",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://apitryout.qtestnet.com/api/v3/projects/:projectId/requirements",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "ID of the project"
              },
              {
                "name": "parentId",
                "value": "",
                "type": "query",
                "description": "Specify the parent Module's ID to retrieve all of its Requirements which are located directly under the parent Module"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "By default the first page is returned but you can specify any page number to retrieve requirements."
              },
              {
                "name": "size",
                "value": "",
                "type": "query",
                "description": "The result is paginated. By the default, the number of requirements in each page is 20.\n\nYou can specify your custom number in this parameter."
              },
              {
                "name": "includeExternalProperties",
                "value": "",
                "type": "query",
                "description": "By default, Requirement external properties are not included in the response. Specify includeExternalProperties=true to include them."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "To retrieve all Requirements or Requirements under a specific Module"
        },
        {
          "info": {
            "name": "Creates a Requirement",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://apitryout.qtestnet.com/api/v3/projects/:projectId/requirements",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "ID of the project"
              },
              {
                "name": "parentId",
                "value": "",
                "type": "query",
                "description": "ID of the parent Module under which the Requirement will be located"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "To create a new Requirement\n\n<strong>qTest Manager version:</strong> 4+"
        },
        {
          "info": {
