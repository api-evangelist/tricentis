                "description": "ID of the project"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Get all Jira connections of a project\n\n<strong>qTest Manager version:</strong> 9.7+"
