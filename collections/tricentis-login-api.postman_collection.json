        {
          "id": "27ee5a71-100b-4cbc-b485-172e480c0a19",
          "name": "Log in",
          "request": {
            "name": "Log in",
            "description": {
              "content": "To authenticate the API client against qTest Manager and acquire authorized access token. \n\n Note: Please choose parameter <em>content-type=application/x-www-form-urlencoded</em>",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "oauth",
                "token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "disabled": false,
                  "key": "grant_type",
                  "value": "password",
                  "description": "Use <em>grant_type=password</em> or <em>grant_type=refresh_token</em> to refresh access token"
                },
                {
                  "disabled": false,
                  "key": "username",
                  "value": "<string>",
                  "description": "Your qTest Manager username"
                },
                {
                  "disabled": false,
                  "key": "password",
                  "value": "<string>",
                  "description": "Your qTest Manager password"
                },
                {
                  "disabled": false,
                  "key": "refresh_token",
                  "value": "<string>",
                  "description": "qTest refresh token to refresh access token associate with provided refresh token"
                }
              ]
            }
          },
          "response": [
            {
              "id": "ca2325b1-19ee-42d9-b4b4-0ae7afcd3b77",
              "name": "<em>token_type</em> and <em>access_token</em> are included in the response.\n\nUse them in Authorization key when making API calls to qTest Manager in following format: <strong>[token_type] [access_token]</strong>",
              "originalRequest": {
                "url": {
                  "path": [
                    "oauth",
                    "token"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
                },
                "header": [
                  {
                    "disabled": false,
                    "description": "Basic + [base64 string of \"<strong>your qTest site name and colon</strong>\"]\n\nor Basic cXRlc3QtYXBpOg== [base64 string of \"<strong>qtest-api:</strong>\"] to use refresh token (grant_type = refresh_token)\n\nExample: qTest Manager site is: apitryout.qtestnet.com then site name is: apitryout + ':', then Authorization is: Basic YXBpdHJ5b3V0Og==",
                    "key": "Authorization",
                    "value": "string"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "urlencoded",
                  "urlencoded": [
                    {
                      "disabled": false,
                      "description": {
                        "content": "Use <em>grant_type=password</em> or <em>grant_type=refresh_token</em> to refresh access token",
                        "type": "text/plain"
                      },
                      "key": "grant_type",
                      "value": "password"
                    },
                    {
                      "disabled": false,
                      "description": {
                        "content": "Your qTest Manager username",
                        "type": "text/plain"
                      },
                      "key": "username",
                      "value": "<string>"
                    },
                    {
                      "disabled": false,
                      "description": {
                        "content": "Your qTest Manager password",
                        "type": "text/plain"
                      },
                      "key": "password",
                      "value": "<string>"
                    },
                    {
                      "disabled": false,
                      "description": {
                        "content": "qTest refresh token to refresh access token associate with provided refresh token",
                        "type": "text/plain"
                      },
                      "key": "refresh_token",
                      "value": "<string>"
                    }
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"access_token\": \"19e28687-0e67-41e8-a9b4-849ca7ea1741\",\n  \"token_type\": \"bearer\",\n  \"refresh_token\": \"913aac60-039e-4f79-a890-fa804a8a6e9f\",\n  \"scope\": \"read import administration create share baseline write delete execute export\",\n  \"agent\": \"string\",\n  \"expires_in\": 300\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
            },
