      "items": [
        {
          "info": {
            "name": "Gets multiple Test Cases",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://apitryout.qtestnet.com/api/v3/projects/:projectId/test-cases",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "ID of the project"
              },
              {
                "name": "parentId",
                "value": "",
                "type": "query",
                "description": "Module ID"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "By default the first page is returned. However, you can specify any page number to retrieve test cases."
              },
              {
                "name": "size",
                "value": "",
                "type": "query",
                "description": "The result is paginated. By the default, the number of requirements in each page is 20.\n\nYou can specify your custom number in this parameter."
              },
              {
                "name": "expandProps",
                "value": "",
                "type": "query",
                "description": "By default, Test Case properties are included in the response. specify <em>expandProps=false</em> to exclude them"
              },
              {
                "name": "expandSteps",
                "value": "",
                "type": "query",
                "description": "By default, Test Steps are excluded from the response body. Input <em>expandSteps=true</em> to include Test Steps"
              },
              {
                "name": "showParamIdentifier",
                "value": "",
                "type": "query",
                "description": "By default, Parameters in Test Steps are displayed in ID number mode (like \"<strong>[~123]</strong>\"). Input <strong><em>showParamIdentifier=true</em></strong> to change to Identifier text mode. Result should be like \"<strong>[~myIdentifier]</strong>\"."
              },
              {
                "name": "utc",
                "value": "",
                "type": "query"
              },
              {
                "name": "modifiedAfter",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "To retrieve all Test Cases or Test Cases which are located directly under a Module"
        },
