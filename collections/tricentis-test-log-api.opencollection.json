                "description": "ID of the project"
              },
              {
                "name": "testRunId",
                "value": "",
                "type": "path",
                "description": "ID of the Test Run"
              },
              {
                "name": "encodeNote",
                "value": "",
                "type": "query",
                "description": "encodeNote"
              },
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "id"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
